# op:// references only — never the key itself. Loaded at run time with:
#   op run --env-file=.env.op -- <command>
#
# Replace <item> with your own BadgerBrain item in 1Password
# (mine is MLM26-BadgerForge_rzhang569; yours has your NetID).
# Check your vault name with: op vault list
LLM_BASE_URL=https://llm-gw01.doit.wisc.edu/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=op://Employee/<item>/credential

# Reasoning model: thinking tokens count against this. Below ~8192 the model
# burns the budget mid-thought and every response comes back empty.
LLM_MAX_TOKENS=8192
