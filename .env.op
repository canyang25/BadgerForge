# op:// references only — never the key itself. Loaded at run time with:
#   op run --env-file=.env.op -- <command>
#
# Replace <item> with your own BadgerBrain item in 1Password
# (mine is MLM26-BadgerForge_rzhang569; yours has your NetID).
# Check your vault name with: op vault list
LLM_BASE_URL=https://llm-gw01.doit.wisc.edu/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=op://Employee/<item>/credential

# Reasoning model: thinking tokens count against this. Below ~8192 every
# response comes back empty. At 8192 a quarter of the full run's tasks gave up
# on replies cut off mid-thought; 16384 cut those give-ups from 8 to 3 on the
# dev slice (docs/experiments.md, 2026-10-09).
LLM_MAX_TOKENS=16384

# Start each task at the server's default effort (empty = leave it to the
# server; its default is the highest), then drop to medium for the rest of the
# task once it has run 360 s and the last 3 replies averaged 3000+ tokens.
# 55/89 in the 2026-11-20 full run vs 49 at a fixed medium
# (docs/experiments.md). These are also the code defaults.
LLM_REASONING_EFFORT=
AGENT_EFFORT_SWITCH=medium
